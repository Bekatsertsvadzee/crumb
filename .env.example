# Supabase — Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...        # service_role. SERVER ONLY. never in the browser.

# Public (safe to expose) — used by the Next.js app
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Cookie Chain
NEXT_PUBLIC_RPC_URL=https://rpc.cookiescan.io
NEXT_PUBLIC_EXPLORER=https://cookiescan.io

# Absolute URL of the deployment, for Open Graph tags
NEXT_PUBLIC_SITE_URL=https://crumb.vercel.app

# Collector tuning
MIN_LIQUIDITY_USD=0
